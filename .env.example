# Load these into the server environment. Node does not implicitly load this file.
# Optional live Qwen model. This example uses Alibaba Cloud Beijing.
# For self-hosted Qwen, set its actual /v1 endpoint and served model ID.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max-0902
# QWEN_API_KEY_FILE=/absolute/path/to/your/private-key-file
# QWEN_ALLOW_HTTP=true
PORT=4173
HOST=127.0.0.1
# For a deliberate protected/public SYNTHETIC demo only:
# DEMO_PUBLIC=true
# APP_ORIGIN=https://demo.example.com
